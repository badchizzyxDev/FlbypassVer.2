[app]
title = FL Bypass
package.name = flbypass
package.domain = org.bypass
source.dir = .
source.include_exts = py,png,jpg,kv,atlas
version = 2.0
requirements = python3,kivy
orientation = portrait
android.permissions = INTERNET,CHANGE_NETWORK_STATE,ACCESS_NETWORK_STATE,WRITE_SETTINGS,CHANGE_WIFI_STATE
android.api = 33
android.minapi = 21
android.archs = arm64-v8a

[buildozer]
log_level = 2
